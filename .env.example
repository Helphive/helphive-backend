PORT=
NODE_ENV=
DATABASE_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
EMAIL_VERIFICATION_SECRET=
GOOGLE_CLOUD_SERVICE_ACCOUNT_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=
GOOGLE_CLOUD_TASKS_SECRET=
STRIPE_CONNECTED_WEBHOOK_SECRET=
COMET_CHAT_REST_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://helphive.himaiz.com,https://admin.helphive.himaiz.com
# Signs admin tokens. Falls back to ACCESS_TOKEN_SECRET while unset; set a different random value (64+ chars).
ADMIN_ACCESS_TOKEN_SECRET=
# Proxy hops in front of the app (Cloud Run: 1). Decides the client IP that rate limits use.
TRUST_PROXY_HOPS=1
# Keys the hashes of sign-in rate-limit records (account cap counters and the addresses each account signed in from
# in the last 30 days). Falls back to ACCESS_TOKEN_SECRET; changing it only forgets the remembered addresses.
# Sign-in limits (code, not env): users 30 failures/15 min per address, 5/15 min per account+address,
# 300/hour per account (known addresses exempt); admins 10, 5 and 100.
RATE_LIMIT_HASH_SECRET=

# --- Admin console sessions (defaults keep today's behaviour) ---
# Admin access-token lifetime. Default 8h (what the deployed console expects). Set 15m once the console refreshes.
ADMIN_ACCESS_TOKEN_TTL=
# Longest an admin sign-in lasts however often it refreshes (default 12h), and the idle limit for refresh (default 2h).
ADMIN_SESSION_TTL=
ADMIN_SESSION_IDLE_TTL=
# Tags admin refresh tokens. Default: derived from ADMIN_ACCESS_TOKEN_SECRET. Changing it ends admin sessions.
ADMIN_REFRESH_TOKEN_SECRET=
# Browser origins allowed to call /admin (comma separated; replaces the default https://admin.helphive.himaiz.com).
# http://localhost and http://127.0.0.1 on any port are always allowed for console development.
ADMIN_CONSOLE_ORIGINS=
# Encrypts admin two-step (TOTP) secrets: 32 bytes as 64 hex characters or base64. If unset, a key is derived from
# ADMIN_ACCESS_TOKEN_SECRET (else ACCESS_TOKEN_SECRET); rotating that secret would then break every enrolled second
# factor (a super admin must reset them). Set this before anyone enrols, and never change it afterwards.
ADMIN_MFA_ENCRYPTION_KEY=
# How long a one-time password from POST /admin/admins stays usable (default 72h).
ADMIN_TEMP_PASSWORD_TTL=

# --- Data and logging ---
# false: do not create indexes at start-up (then run scripts/create-indexes.ts --apply). Default true, as today.
MONGOOSE_AUTO_INDEX=
# Overrides the project id used in the Cloud Logging trace field (default: helphive).
GOOGLE_CLOUD_PROJECT=

# --- Outbound email recipient policy (lib/emailPolicy.ts) ---
# Domains always allowed past the reserved/disposable/block-list/DNS rules, for false positives (comma separated).
EMAIL_ALLOWED_DOMAINS=
# Extra domains never emailed and refused at sign-up (comma separated; subdomains included).
EMAIL_BLOCKED_DOMAINS=

# --- Public demo admin (read-only, masked; see backend-platform.md) ---
# Emails treated as the demo admin whatever their stored role (comma separated; default demo.admin@helphive.himaiz.com).
DEMO_ADMIN_EMAILS=
