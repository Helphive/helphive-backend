PORT=
NODE_ENV=
DATABASE_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
EMAIL_VERIFICATION_SECRET=
# Google Cloud Storage and Cloud Tasks use Application Default Credentials (no key file): on Cloud Run the service
# account, locally `gcloud auth application-default login`.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=
GOOGLE_CLOUD_TASKS_SECRET=
STRIPE_CONNECTED_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://helphive.himaiz.com,https://admin.helphive.himaiz.com
# Signs admin tokens. Falls back to ACCESS_TOKEN_SECRET while unset; set a different random value (64+ chars).
ADMIN_ACCESS_TOKEN_SECRET=
# Proxy hops in front of the app (Cloud Run: 1). Decides the client IP that rate limits use.
TRUST_PROXY_HOPS=1
# Keys the hashes of sign-in rate-limit records (account cap counters and the addresses each account signed in from
# in the last 30 days). Falls back to ACCESS_TOKEN_SECRET; changing it only forgets the remembered addresses.
# Sign-in limits (code, not env): users 30 failures/15 min per address, 5/15 min per account+address,
# 300/hour per account (known addresses exempt); admins 10, 5 and 100.
RATE_LIMIT_HASH_SECRET=

# --- Admin console sessions (defaults keep today's behaviour) ---
# Admin access-token lifetime. Default 8h (what the deployed console expects). Set 15m once the console refreshes.
ADMIN_ACCESS_TOKEN_TTL=
# Longest an admin sign-in lasts however often it refreshes (default 12h), and the idle limit for refresh (default 2h).
ADMIN_SESSION_TTL=
ADMIN_SESSION_IDLE_TTL=
# Tags admin refresh tokens. Default: derived from ADMIN_ACCESS_TOKEN_SECRET. Changing it ends admin sessions.
ADMIN_REFRESH_TOKEN_SECRET=
# Browser origins allowed to call /admin (comma separated; replaces the default https://admin.helphive.himaiz.com).
# http://localhost and http://127.0.0.1 on any port are always allowed for console development.
ADMIN_CONSOLE_ORIGINS=
# Encrypts admin two-step (TOTP) secrets: 32 bytes as 64 hex characters or base64. If unset, a key is derived from
# ADMIN_ACCESS_TOKEN_SECRET (else ACCESS_TOKEN_SECRET); rotating that secret would then break every enrolled second
# factor (a super admin must reset them). Set this before anyone enrols, and never change it afterwards.
ADMIN_MFA_ENCRYPTION_KEY=
# How long a one-time password from POST /admin/admins stays usable (default 72h).
ADMIN_TEMP_PASSWORD_TTL=

# --- Data and logging ---
# false: do not create indexes at start-up (then run scripts/create-indexes.ts --apply). Default true, as today.
MONGOOSE_AUTO_INDEX=
# Overrides the project id used in the Cloud Logging trace field (default: helphive).
GOOGLE_CLOUD_PROJECT=

# --- Outbound email recipient policy (lib/emailPolicy.ts) ---
# Domains always allowed past the reserved/disposable/block-list/DNS rules, for false positives (comma separated).
EMAIL_ALLOWED_DOMAINS=
# Extra domains never emailed and refused at sign-up (comma separated; subdomains included).
EMAIL_BLOCKED_DOMAINS=

# --- Public demo admin (read-only, masked; see backend-platform.md) ---
# Emails treated as the demo admin whatever their stored role (comma separated; default demo.admin@helphive.himaiz.com).
DEMO_ADMIN_EMAILS=

# --- Address lookup (lib/places.ts; see scratch/address/address-contract.md) ---
# Server-side Google Maps Platform key: Places API (New) and Geocoding API only, restricted by API (not by app or
# referrer). Unset: /auth/places/* answer 503 places_not_configured and the apps fall back to a map pin plus typed text.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Chat (CometChat; config/chat.ts) ---
# All three are required for chat; while any is unset the chat endpoints answer 503 chat_not_configured and sign-up,
# profile and booking flows skip CometChat. The app id and region are not secret; today's app is 26925431c1f0b1aa in
# region eu (documentation only: set them here, never in code).
COMETCHAT_APP_ID=
COMETCHAT_REGION=
# REST API key (fullAccess). The key that was hard-coded in this repository (git history since 92d2ae0) is public:
# create a new one in the dashboard, set it here, then delete the old one. COMET_CHAT_REST_API_KEY (the old name)
# is still read when this one is unset.
COMETCHAT_REST_API_KEY=
# Basic-auth credentials configured on the CometChat webhook (alphanumeric; password at least 24 characters).
# Unset: POST /webhook/cometchat answers 503 (no push notifications or chat events).
COMETCHAT_WEBHOOK_USERNAME=
COMETCHAT_WEBHOOK_PASSWORD=
# Encrypts per-session CometChat auth tokens at rest (32 bytes, hex or base64). Unset: derived from ACCESS_TOKEN_SECRET.
CHAT_TOKEN_ENCRYPTION_KEY=
# Days a customer and provider may still chat after their last shared booking was completed or cancelled (default 7).
CHAT_GRACE_DAYS=
# Days a chat report (with its copy of the reported message) is kept (default 365, minimum 30).
CHAT_RETENTION_DAYS=
# Attachment policy enforced by the webhook (and to be mirrored in the CometChat role permissions).
# Default: 10 MB; image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,application/pdf.
CHAT_ATTACHMENT_MAX_MB=
CHAT_ATTACHMENT_TYPES=
# false: the webhook only records messages and never deletes rule-breaking ones (default true).
CHAT_WEBHOOK_ENFORCE=
# false: no push notification for new chat messages (default true).
CHAT_PUSH=
# false: chat pushes carry no message text ("Sam sent you a message"); default: first name and a 60-character preview.
CHAT_PUSH_PREVIEW=
# At most one chat push per conversation per receiver in this many seconds (default 30; the device collapses the rest).
CHAT_PUSH_MIN_INTERVAL_SECONDS=
# false: stop targeting the user-id OneSignal alias that app builds before push registration use (default true; turn
# off once no older build is in use, since any device can claim a user-id alias).
PUSH_LEGACY_EXTERNAL_ID=

# --- Earnings ---
# Seconds after completion before a provider's earning is released (default 30: today's test-mode behaviour).
# Shown to admins (GET /admin/platform/settings) and providers (releasePolicy in get-earnings).
EARNINGS_RELEASE_DELAY_SECONDS=

# --- App identity and links (lib/appIdentity.ts; see scratch/mobile/app-identity-contract.md) ---
# Web app origin the Stripe onboarding return sends web users to (default https://helphive.himaiz.com).
WEB_APP_URL=
# Extra SHA-256 signing fingerprints for com.himaiz.helphive.app in assetlinks.json (comma separated), e.g. the Play
# app signing key once the new listing exists.
ANDROID_APP_EXTRA_SHA256=


# --- Client attestation (lib/clientAttest, POST /client-attest, middleware/clientPass.ts) ---
# off (default): no checks and /client-attest answers 503. log: check X-Client-Pass and log, never block. enforce: 428.
CLIENT_ATTEST_MODE=off
# Signs client passes (HS256), 32+ characters. Missing or shorter: /client-attest answers 503 and the checks only log.
CLIENT_PASS_SECRET=
# Pass lifetimes in seconds (defaults 3600 for Android, 43200 for web).
CLIENT_PASS_TTL_ANDROID_SEC=
CLIENT_PASS_TTL_WEB_SEC=
# reCAPTCHA Enterprise score key for the website (project: GOOGLE_CLOUD_PROJECT, default helphive); web attestation answers 503 without it.
RECAPTCHA_SITE_KEY=
# Lowest reCAPTCHA score accepted, 0 to 1 (default 0.5).
RECAPTCHA_MIN_SCORE=
# Debug tokens for test builds and emulators (comma separated, each 32+ characters; shorter ones are ignored). Leave empty in production.
ATTEST_DEBUG_TOKENS=

# Secrets bundle (config/loadSecrets.ts): on Cloud Run, Secret Manager secret helphive-secrets (a JSON object of strings)
# arrives as APP_SECRETS and is unpacked into process.env before anything else. Leave it unset locally.
# APP_SECRETS=

# Cloudflare origin lock (lib/originAuth.ts): the Worker helphive-api-edge sends ORIGIN_AUTH as X-Origin-Auth and the visitor
# IP as X-Client-IP. ORIGIN_AUTH lives in helphive-secrets; ORIGIN_AUTH_MODE=enforce refuses direct calls (log otherwise).
# Leave both unset locally.
# ORIGIN_AUTH=
# ORIGIN_AUTH_MODE=
