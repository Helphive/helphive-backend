PORT=
NODE_ENV=
DATABASE_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
EMAIL_VERIFICATION_SECRET=
GOOGLE_CLOUD_SERVICE_ACCOUNT_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=
GOOGLE_CLOUD_TASKS_SECRET=
STRIPE_CONNECTED_WEBHOOK_SECRET=
COMET_CHAT_REST_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://helphive.himaiz.com,https://admin.helphive.himaiz.com
# Signs admin tokens. Falls back to ACCESS_TOKEN_SECRET while unset; set a different random value (64+ chars).
ADMIN_ACCESS_TOKEN_SECRET=
# Proxy hops in front of the app (Cloud Run: 1). Decides the client IP that rate limits use.
TRUST_PROXY_HOPS=1
# Keys the hashes of sign-in rate-limit records (account cap counters and the addresses each account signed in from
# in the last 30 days). Falls back to ACCESS_TOKEN_SECRET; changing it only forgets the remembered addresses.
# Sign-in limits (code, not env): users 30 failures/15 min per address, 5/15 min per account+address,
# 300/hour per account (known addresses exempt); admins 10, 5 and 100.
RATE_LIMIT_HASH_SECRET=
